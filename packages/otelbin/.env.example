###############################
###### OPTIONAL ENV VARS ######
###############################

# Upstash Redis – optional.
# Enables short-link persistence when Clerk is also configured, and rate limiting
# for short-link creation and server-side validation.
# Without Upstash, OTelBin still supports editing, visualization, full-URL sharing,
# downloads, and server-side validation (when the validation backend below is configured).
# Get your Redis REST URL and Token here: https://upstash.com/docs/redis/overall/getstarted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk authentication – optional.
# Enables user sign up/in. Short-link creation is available only when both Clerk
# and Upstash are configured. Without Clerk, the core editor and sharing by full URL
# remain available.
# Get yourself a free Clerk account: https://clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OTelBin can send self monitoring data to Dash0 using the @dash0hq/sdk-web
NEXT_PUBLIC_DASH0_SERVICE_NAME=
NEXT_PUBLIC_DASH0_URL=
NEXT_PUBLIC_DASH0_AUTH_TOKEN=

# React flow is the charting system.
# Whether to show or hide the attribution notice. Defaults to `false`
# https://reactflow.dev/docs/guides/remove-attribution/
NEXT_PUBLIC_HIDE_REACT_FLOW_ATTRIBUTION=

# OTelBin can validate the configuration against real collector distributions.
# This URL points to such a deployed validator.
COLLECTOR_CONFIGURATION_VALIDATION_URL=
COLLECTOR_CONFIGURATION_VALIDATION_API_KEY=

# Policies
# When at least one of these env vars is configured, OTelBin will show a legal button in its footer
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_COOKIE_POLICY_URL=
NEXT_PUBLIC_TERMS_AND_CONDITIONS_URL=
NEXT_PUBLIC_ACCEPTABLE_USE_URL=
